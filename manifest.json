{
  "manifest_version": 3,
  "name": "Meet Session Recorder",
  "version": "1.2.0",
  "description": "Sign in with Google, track a live Meet session, and send 16-frame face crops and face-landmark data for engagement analysis.",
  "minimum_chrome_version": "116",

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "identity",
    "storage",
    "tabs",
    "scripting",
    "offscreen"
  ],

  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },

  "oauth2": {
    "client_id": "PASTE_YOUR_REAL_CLIENT_ID_HERE",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },

  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
